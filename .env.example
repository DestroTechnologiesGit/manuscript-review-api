# Copy this file to .env and fill in the values.

# THE REVIEWER — finds what is wrong with the book.
# A different company's model, on purpose: it has no stake in defending text
# Claude wrote, so it does not skip over big problems the way a model reviewing
# its own work does. Get a key at https://platform.openai.com (API keys).
OPENAI_API_KEY=

# THE WRITER — makes only the fixes you approve.
# Your key from https://console.anthropic.com (Settings > API keys)
ANTHROPIC_API_KEY=

# Password people must enter to use the dashboard. Keep this set if the server is online.
APP_PASSWORD=

# Optional settings.
# These two are only the DEFAULTS the dropdowns start on — you can change the
# reviewer and the rewriter on the upload page without editing this file.
OPENAI_MODEL=gpt-5
CLAUDE_MODEL=claude-opus-5
REVIEW_EFFORT=high
MAX_TOKENS=32000
PORT=3000
